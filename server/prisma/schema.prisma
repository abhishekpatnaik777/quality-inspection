generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
  invited

  @@map("user_status")
}

enum UserRoleName {
  quality_engineer
  supervisor

  @@map("user_role_name")
}

enum UserRoleStatus {
  active
  inactive

  @@map("user_role_status")
}

enum UserSupervisorStatus {
  active
  inactive

  @@map("user_supervisor_status")
}

enum SkuCategory {
  electronics
  mechanical
  consumable
  other

  @@map("sku_category")
}

enum InspectionStatus {
  pending
  pass
  fail

  @@map("inspection_status")
}

enum AiInspectionStatus {
  processing
  awaiting_verification
  completed
  error

  @@map("ai_inspection_status")
}

enum DefectType {
  scratch
  dent
  paint_issue
  missing_component
  no_defect

  @@map("defect_type")
}

enum PredictionStatus {
  pending
  approved
  overridden

  @@map("prediction_status")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  email     String     @unique @db.VarChar(255)
  status    UserStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?       @map("created_by")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?       @map("updated_by")

  createdByUser User?  @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?  @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdUsers  User[] @relation("UserCreatedBy")
  updatedUsers  User[] @relation("UserUpdatedBy")

  roles UserRole[]

  rolesCreated UserRole[] @relation("UserRoleCreatedBy")
  rolesUpdated UserRole[] @relation("UserRoleUpdatedBy")

  qualityEngineerLink UserSupervisor?  @relation("QualityEngineerAssignment")
  supervisedEngineers UserSupervisor[] @relation("SupervisorAssignment")

  supervisorLinksCreated UserSupervisor[] @relation("UserSupervisorCreatedBy")
  supervisorLinksUpdated UserSupervisor[] @relation("UserSupervisorUpdatedBy")

  skusCreated              Sku[]               @relation("SkuCreatedBy")
  skusUpdated              Sku[]               @relation("SkuUpdatedBy")
  manufacturingUnitsCreated ManufacturingUnit[] @relation("ManufacturingUnitCreatedBy")
  manufacturingUnitsUpdated ManufacturingUnit[] @relation("ManufacturingUnitUpdatedBy")
  batchesCreated           Batch[]             @relation("BatchCreatedBy")
  batchesUpdated           Batch[]             @relation("BatchUpdatedBy")
  productsCreated          Product[]           @relation("ProductCreatedBy")
  productsUpdated          Product[]           @relation("ProductUpdatedBy")

  inspections              Inspection[]        @relation("InspectionEngineer")
  inspectionsCreated       Inspection[]        @relation("InspectionCreatedBy")
  inspectionsUpdated       Inspection[]        @relation("InspectionUpdatedBy")
  aiInspectionsCreated     AiInspection[]      @relation("AiInspectionCreatedBy")
  aiInspectionsUpdated     AiInspection[]      @relation("AiInspectionUpdatedBy")
  predictionsVerified      AiInspectionPrediction[] @relation("PredictionVerifiedBy")
  predictionsCreated       AiInspectionPrediction[] @relation("PredictionCreatedBy")
  predictionsUpdated       AiInspectionPrediction[] @relation("PredictionUpdatedBy")
  inspectionResultsCreated InspectionResult[]  @relation("InspectionResultCreatedBy")
  inspectionResultsUpdated InspectionResult[]  @relation("InspectionResultUpdatedBy")

  @@index([status], map: "idx_users_status")
  @@index([email], map: "idx_users_email")
  @@map("users")
}

model UserRole {
  id        Int            @id @default(autoincrement())
  userId    Int            @map("user_id")
  role      UserRoleName
  status    UserRoleStatus @default(active)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?           @map("created_by")
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?           @map("updated_by")

  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("UserRoleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("UserRoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([userId], map: "idx_user_roles_user_id")
  @@index([status], map: "idx_user_roles_status")
  @@map("user_roles")
}

model UserSupervisor {
  id           Int                  @id @default(autoincrement())
  userId       Int                  @unique @map("user_id")
  supervisorId Int                  @map("supervisor_id")
  status       UserSupervisorStatus @default(active)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    Int?                 @map("created_by")
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    Int?                 @map("updated_by")

  qualityEngineer User  @relation("QualityEngineerAssignment", fields: [userId], references: [id], onDelete: Cascade)
  supervisor      User  @relation("SupervisorAssignment", fields: [supervisorId], references: [id], onDelete: Restrict)
  createdByUser   User? @relation("UserSupervisorCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser   User? @relation("UserSupervisorUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([supervisorId], map: "idx_user_supervisors_supervisor_id")
  @@index([status], map: "idx_user_supervisors_status")
  @@map("user_supervisors")
}

model Sku {
  id        Int         @id @default(autoincrement())
  name      String      @db.VarChar(255)
  category  SkuCategory
  model     String      @db.VarChar(255)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?        @map("created_by")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?        @map("updated_by")

  createdByUser User? @relation("SkuCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("SkuUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  batches Batch[]

  @@unique([category, model])
  @@index([category], map: "idx_skus_category")
  @@map("skus")
}

model ManufacturingUnit {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  location  String   @db.VarChar(255)
  capacity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  createdByUser User? @relation("ManufacturingUnitCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("ManufacturingUnitUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  batches Batch[]

  @@index([name], map: "idx_manufacturing_units_name")
  @@map("manufacturing_units")
}

model Batch {
  id                  Int      @id @default(autoincrement())
  batchNumber         String   @unique @map("batch_number") @db.VarChar(64)
  manufacturingUnitId Int      @map("manufacturing_unit_id")
  skuId               Int      @map("sku_id")
  manufacturingDate   DateTime @map("manufacturing_date") @db.Date
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           Int?     @map("created_by")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy           Int?     @map("updated_by")

  manufacturingUnit ManufacturingUnit @relation(fields: [manufacturingUnitId], references: [id], onDelete: Restrict)
  sku               Sku               @relation(fields: [skuId], references: [id], onDelete: Restrict)
  createdByUser     User?             @relation("BatchCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser     User?             @relation("BatchUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  products Product[]

  @@index([manufacturingUnitId], map: "idx_batches_manufacturing_unit_id")
  @@index([skuId], map: "idx_batches_sku_id")
  @@map("batches")
}

model Product {
  id        Int      @id @default(autoincrement())
  batchId   Int      @map("batch_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  batch         Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("ProductUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  inspections Inspection[]

  @@index([batchId], map: "idx_products_batch_id")
  @@map("products")
}

model Inspection {
  id             Int              @id @default(autoincrement())
  userId         Int              @map("user_id")
  productId      Int              @map("product_id")
  inspectionDate DateTime         @default(now()) @map("inspection_date") @db.Date
  status         InspectionStatus @default(pending)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int?             @map("created_by")
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int?             @map("updated_by")

  engineer      User  @relation("InspectionEngineer", fields: [userId], references: [id], onDelete: Restrict)
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByUser User? @relation("InspectionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("InspectionUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  aiInspections AiInspection[]
  results       InspectionResult[]

  @@index([userId], map: "idx_inspections_user_id")
  @@index([productId], map: "idx_inspections_product_id")
  @@index([status], map: "idx_inspections_status")
  @@map("inspections")
}

model AiInspection {
  id           Int                @id @default(autoincrement())
  inspectionId Int                @map("inspection_id")
  imageUrl     String             @map("image_url") @db.VarChar(512)
  status       AiInspectionStatus @default(processing)
  rawResponse  Json?              @map("raw_response")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    Int?               @map("created_by")
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    Int?               @map("updated_by")

  inspection    Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  createdByUser User?      @relation("AiInspectionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?      @relation("AiInspectionUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  predictions AiInspectionPrediction[]

  @@index([inspectionId], map: "idx_ai_inspections_inspection_id")
  @@index([status], map: "idx_ai_inspections_status")
  @@map("ai_inspections")
}

model AiInspectionPrediction {
  id              Int             @id @default(autoincrement())
  aiInspectionId  Int             @map("ai_inspection_id")
  aiDefectType    DefectType      @map("ai_defect_type")
  confidence      Decimal         @db.Decimal(5, 4)
  status          PredictionStatus @default(pending)
  finalDefectType DefectType?     @map("final_defect_type")
  comment         String?         @db.Text
  verifiedBy      Int?            @map("verified_by")
  verifiedAt      DateTime?       @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       Int?            @map("created_by")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       Int?            @map("updated_by")

  aiInspection  AiInspection @relation(fields: [aiInspectionId], references: [id], onDelete: Cascade)
  verifier      User?        @relation("PredictionVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)
  createdByUser User?        @relation("PredictionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?        @relation("PredictionUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  result InspectionResult?

  @@index([aiInspectionId], map: "idx_ai_inspection_predictions_ai_inspection_id")
  @@index([status], map: "idx_ai_inspection_predictions_status")
  @@map("ai_inspection_predictions")
}

model InspectionResult {
  id                       Int        @id @default(autoincrement())
  inspectionId             Int        @map("inspection_id")
  aiInspectionPredictionId Int        @unique @map("ai_inspection_prediction_id")
  defectType               DefectType @map("defect_type")
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                Int?       @map("created_by")
  updatedAt                DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                Int?       @map("updated_by")

  inspection Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  prediction AiInspectionPrediction @relation(fields: [aiInspectionPredictionId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("InspectionResultCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("InspectionResultUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([inspectionId], map: "idx_inspection_results_inspection_id")
  @@index([defectType], map: "idx_inspection_results_defect_type")
  @@map("inspection_results")
}
