# Copy to backend/.env (from repo root):
#   cp backend/.env.example backend/.env
# Then set YOUR_MAC_USERNAME to `whoami` (Postgres.app default, usually no password).

DATABASE_URL=postgresql://YOUR_MAC_USERNAME@127.0.0.1:5432/quality_inspection
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Replace googleAPIKey with your Google AI Studio / Gemini API key
# (placeholder is ignored; vision falls back to mock)
GOOGLE_AI_API_KEY=googleAPIKey
GOOGLE_VISION_MODEL=gemini-3.8-flash
# Set to true to force mock predictions even when a real key is present
MOCK_VISION=false
